# =============================================================================
# NEXUS EDU – Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# --- Application ---
APP_NAME=NEXUS_EDU
APP_ENV=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=https://nexus-ai-a1-cmi1.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# --- LLM Provider Keys ---
GROQ_API_KEY=your_groq_api_key_here

# --- Database (PostgreSQL required) ---
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/NexusAI
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/NexusAI
# After setting DATABASE_URL, run migrations once:
#   cd backend && alembic upgrade head

# --- Security ---
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Storage ---
UPLOAD_DIR=app/storage/uploads
GENERATED_DIR=app/storage/generated
TEMP_DIR=app/storage/temp
