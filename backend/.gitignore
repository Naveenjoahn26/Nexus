# =============================================================================
# NEXUS EDU – Git Ignore
# =============================================================================

# --- Environment & Secrets ---
.env
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual Environment ---
venv/
.venv/
env/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Database ---
*.db
*.sqlite3

# --- Storage (runtime artifacts) ---
app/storage/uploads/*
app/storage/generated/*
app/storage/temp/*
!app/storage/uploads/.gitkeep
!app/storage/generated/.gitkeep
!app/storage/temp/.gitkeep

# --- OS ---
.DS_Store
Thumbs.db

# --- Testing ---
.coverage
htmlcov/
.pytest_cache/

# --- Logs ---
*.log
logs/
